// Third candidate: exclude pending requests, and require no settled refund.
// "No refund request for this claim is outstanding other than this one, and no
// refund has succeeded."  requests == errors + 1  &&  responses == 0.
@id("refund_once_per_approval_pending_aware")
permit (
    principal,
    action == Drupe::Action::"Refund",
    resource
)
when temporal {
    formerly within 15m Drupe::Action::"Approve"::response{
        input.claimId:   context.input.claimId,
        output.approved: true
    }
    && (count for (t: Timepoint). where (
        formerly within 15m (Drupe::Action::"Refund"::request{
            input.claimId: context.input.claimId
        } && tp(t))
    )) == (count for (t: Timepoint). where (
        formerly within 15m (Drupe::Action::"Refund"::error{
            input.claimId: context.input.claimId
        } && tp(t))
    )) + 1
    && (count for (t: Timepoint). where (
        formerly within 15m (Drupe::Action::"Refund"::response{
            input.claimId: context.input.claimId
        } && tp(t))
    )) == 0
};
