@id("probe")
permit ( principal, action == Drupe::Action::"Refund", resource )
when temporal {
    formerly within 15m Drupe::Action::"Approve"::response{
        input.claimId:   context.input.claimId,
        output.approved: true
    }
    && (count for (t: Timepoint). where ( formerly within 15m (Drupe::Action::"Refund"::request{ input.claimId: context.input.claimId } && tp(t)) )) == (count for (t: Timepoint). where ( formerly within 15m (Drupe::Action::"Refund"::error{ input.claimId: context.input.claimId } && tp(t)) )) + 1
};
